# =============================================================================
# ENVIRONMENT VARIABLES TEMPLATE
# =============================================================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env with real credentials to version control
# =============================================================================

# -----------------------------------------------------------------------------
# SERVER CONFIGURATION
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=5001
HOST=0.0.0.0

# -----------------------------------------------------------------------------
# DATABASE CONFIGURATION
# -----------------------------------------------------------------------------
# MongoDB Atlas connection string
# Format: mongodb+srv://username:password@cluster.mongodb.net/database?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://your_username:your_password@your_cluster.mongodb.net/medical_store_system?retryWrites=true&w=majority

# -----------------------------------------------------------------------------
# AUTHENTICATION & SECURITY
# -----------------------------------------------------------------------------
# JWT Secret - Generate using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# MUST be at least 32 characters
JWT_SECRET=your_jwt_secret_here_minimum_64_characters_for_production_security

# Bcrypt rounds (10-12 recommended, higher = more secure but slower)
BCRYPT_ROUNDS=12

# -----------------------------------------------------------------------------
# FIREBASE CONFIGURATION
# -----------------------------------------------------------------------------
# Firebase Admin SDK Service Account (Base64 encoded JSON)
# Download from: Firebase Console → Project Settings → Service Accounts
# Encode to base64: cat service-account.json | base64 -w 0
FIREBASE_SERVICE_ACCOUNT_BASE64=your_base64_encoded_firebase_service_account_json_here

# Firebase Client SDK Configuration
FIREBASE_API_KEY=your_firebase_api_key
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your_sender_id
FIREBASE_APP_ID=your_app_id

# -----------------------------------------------------------------------------
# CORS CONFIGURATION
# -----------------------------------------------------------------------------
# Comma-separated list of allowed origins
CORS_ORIGIN=http://localhost:5173,https://your-frontend-domain.web.app

# -----------------------------------------------------------------------------
# RATE LIMITING
# -----------------------------------------------------------------------------
# Maximum requests per windowMs
RATE_LIMIT_MAX=100
# Time window in milliseconds (15 minutes = 900000ms)
RATE_LIMIT_WINDOW_MS=900000

# -----------------------------------------------------------------------------
# EMAIL CONFIGURATION (Optional - for password reset)
# -----------------------------------------------------------------------------
# SendGrid API Key (https://sendgrid.com)
SENDGRID_API_KEY=SG.your_sendgrid_api_key_here
SENDGRID_FROM_EMAIL=noreply@yourdomain.com
SENDGRID_FROM_NAME=Health Care Surgical Mart

# Alternative: Nodemailer SMTP (if not using SendGrid)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-specific-password

# -----------------------------------------------------------------------------
# SMS CONFIGURATION (Optional - for notifications)
# -----------------------------------------------------------------------------
# Twilio Configuration
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# Alternative SMS providers
# NEXMO_API_KEY=your_nexmo_api_key
# NEXMO_API_SECRET=your_nexmo_api_secret

# -----------------------------------------------------------------------------
# REDIS CONFIGURATION (Optional - for token blacklist & caching)
# -----------------------------------------------------------------------------
# Redis connection URL
# Local: redis://localhost:6379
# Cloud: redis://username:password@host:port
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=your_redis_password_if_required

# -----------------------------------------------------------------------------
# STORAGE CONFIGURATION (Optional - for file uploads)
# -----------------------------------------------------------------------------
# AWS S3 Configuration
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_S3_BUCKET=your-bucket-name
AWS_REGION=us-east-1

# Alternative: Google Cloud Storage
# GCS_PROJECT_ID=your-gcp-project-id
# GCS_BUCKET=your-gcs-bucket-name
# GCS_KEY_FILE=path/to/keyfile.json

# -----------------------------------------------------------------------------
# LOGGING & MONITORING
# -----------------------------------------------------------------------------
# Log level: error, warn, info, debug
LOG_LEVEL=info

# Sentry DSN (for error tracking)
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# Application Insights (Azure)
# APPINSIGHTS_INSTRUMENTATIONKEY=your-instrumentation-key

# -----------------------------------------------------------------------------
# API KEYS & EXTERNAL SERVICES
# -----------------------------------------------------------------------------
# External API key for third-party integrations
EXTERNAL_API_KEY=your_external_api_key_here

# Payment Gateway (if applicable)
# STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
# STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key

# -----------------------------------------------------------------------------
# FEATURE FLAGS (Optional)
# -----------------------------------------------------------------------------
# Enable/disable specific features
ENABLE_SMS_NOTIFICATIONS=false
ENABLE_EMAIL_NOTIFICATIONS=false
ENABLE_PUSH_NOTIFICATIONS=false
ENABLE_ANALYTICS=true
ENABLE_DEBUG_MODE=false

# -----------------------------------------------------------------------------
# SHOP CONFIGURATION
# -----------------------------------------------------------------------------
# Default shop ID for development/testing
DEFAULT_SHOP_ID=shop_health_care_01

# -----------------------------------------------------------------------------
# DEVELOPMENT TOOLS (Development only)
# -----------------------------------------------------------------------------
# Enable GraphQL playground
GRAPHQL_PLAYGROUND=true

# Enable request logging
ENABLE_REQUEST_LOGGING=true

# =============================================================================
# DEPLOYMENT CHECKLIST
# =============================================================================
# Before deploying to production:
# [ ] Generate secure JWT_SECRET (minimum 64 characters)
# [ ] Update MongoDB URI with production credentials
# [ ] Encode Firebase service account to base64
# [ ] Set NODE_ENV=production
# [ ] Configure CORS_ORIGIN with production domain
# [ ] Set up SendGrid/SMTP for email
# [ ] Configure Redis for token blacklist
# [ ] Set up Sentry for error tracking
# [ ] Enable SSL/TLS certificates
# [ ] Review and adjust rate limiting settings
# [ ] Disable debug/development features
# =============================================================================
