{
  "name": "medical-store-pos-server",
  "version": "2.0.0",
  "description": "Medical Store POS System - Backend Server",
  "private": true,
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "build": "echo 'No build step required for Node.js'",
    "test": "jest --coverage --verbose --forceExit",
    "test:ci": "jest --verbose --forceExit",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/ --ext .js",
    "lint:fix": "eslint src/ --ext .js --fix",
    "format": "prettier --write \"src/**/*.{js,json,md}\"",
    "seed": "node src/utils/database-initializer.js",
    "seed:test": "node src/scripts/seed-test-data.js",
    "migrate": "node scripts/migrate-users.js && node scripts/migrate-old-schema-to-new.js && node scripts/migrate-missing-snapshots.js",
    "security:audit": "npm audit",
    "logs": "node -e \"const fs=require('fs'),path=require('path');const d=path.join(__dirname,'logs');const files=fs.existsSync(d)?fs.readdirSync(d).filter(x=>x.startsWith('app-')&&x.endsWith('.log')):[];const latest=files.sort().pop();if(!latest){console.log('No app log files found in '+d);process.exit(0)}const p=path.join(d,latest);const s=fs.statSync(p).size;const start=Math.max(0,s-16384);const tail=fs.readFileSync(p,'utf8').slice(start).split('\\n').slice(-200).join('\\n');console.log('--- '+latest+' (last 200 lines) ---');console.log(tail)\""
  },
  "dependencies": {
    "@google-cloud/storage": "^7.21.0",
    "@mailchimp/mailchimp_marketing": "^3.0.80",
    "@sendgrid/mail": "^8.1.6",
    "@sentry/node": "^10.66.0",
    "@sentry/profiling-node": "^10.66.0",
    "axios": "^1.13.4",
    "bcryptjs": "^2.4.3",
    "bull": "^4.16.5",
    "cloudinary": "^2.10.0",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "csv-parser": "^3.2.0",
    "dotenv": "^16.3.1",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "firebase-admin": "^14.2.0",
    "handlebars": "^4.7.8",
    "helmet": "^7.1.0",
    "ioredis": "^5.6.1",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^6.21.0",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^4.6.0",
    "pdfkit": "^0.18.0",
    "redis": "^6.0.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "twilio": "^5.12.0",
    "winston": "^3.11.0",
    "winston-daily-rotate-file": "^4.7.1"
  },
  "devDependencies": {
    "eslint": "^9.39.2",
    "fast-check": "^4.6.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "prettier": "^3.1.1",
    "supertest": "^6.3.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=9.0.0"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
